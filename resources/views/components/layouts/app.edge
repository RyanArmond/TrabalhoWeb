@let(pageTitle = $props.get('title'))
@let(iconSize = 30)

<!DOCTYPE html>
<html
  lang="en-us"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
