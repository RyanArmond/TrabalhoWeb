        :class="sidebarOpen ? 'w-60' : 'w-[3.9375rem]'"
      >
        <nav class="flex flex-col gap-2">
          <a href="{{ route('home') }}" 
            class="flex items-center gap-3 p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-800 hover:text-purple-700 dark:text-zinc-200 dark:hover:text-purple-500" 
          >
            @svg('lucide:house', { width: iconSize, height: iconSize, class: 'shrink-0' })
