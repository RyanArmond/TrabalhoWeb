@layouts.app({ title: 'Lista de Usuários' })
    <div class="flex flex-col w-full max-w-3xl mx-auto p-8 gap-6">

        <h1 class="text-4xl font-extrabold text-indigo-600">Lista dos Usuários:</h1>

        <div class="flex flex-col gap-2">
            @each(user in users)
                <div class="p-3 bg-white dark:bg-zinc-800 rounded-lg shadow-sm border border-zinc-200 dark:border-zinc-700">
                    <p class="text-zinc-900 dark:text-zinc-100 font-medium">
                        {{ user.username }}
                    </p>
                </div>
            @end
        </div>
    </div>
@end