@layouts.app({ title: video.title + ' - Detalhes' })
  <div class="flex flex-col w-full max-w-3xl mx-auto p-12 gap-6 overflow-y-auto h-full">
    <div class="flex items-center gap-4">
      @if(video.user && video.user.avatarUrl)
        <img
          src="{{ video.user.avatarUrl }}"
          alt="Avatar"
          class="w-12 h-12 rounded-full object-cover border-2 border-purple-500 shadow-md shrink-0"
        />
      @else
        <div class="w-12 h-12 rounded-full bg-purple-700 border-2 border-purple-400 flex items-center justify-center font-bold text-white text-base uppercase shadow-md shrink-0">
          {{ video.user && video.user.username ? video.user.username.charAt(0) : 'U' }}
        </div>
      @end

      <div class="min-w-0">
        <h1 class="text-3xl font-bold">{{ video.title }}</h1>
        <div class="text-sm text-zinc-500 dark:text-zinc-400">
          <span>
            Enviado por:
            <strong>{{ video.user ? (video.user.displayName || video.user.username || video.user.email) : 'Anônimo' }}</strong>
          </span>
          @if(video.createdAt)
            <span> • Postado em: {{ video.createdAt.toFormat('dd/MM/yyyy HH:mm') }}</span>
          @end
        </div>
      </div>
    </div>

    <hr class="border border-zinc-300 dark:border-zinc-700" />

    <div class="flex flex-col gap-4 bg-zinc-200 dark:bg-zinc-800 p-6 rounded-xl border border-zinc-300 dark:border-zinc-900">
      <h3 class="font-bold text-lg">Descrição do Produto / Vídeo:</h3>
      <p class="whitespace-pre-line">{{ video.description || 'Nenhuma descrição informada.' }}</p>

      @if(video.url)
        <h4 class="font-bold mt-2">Vídeo do Produto:</h4>
        <div class="flex justify-start">
          <video controls class="max-h-[480px] max-w-full rounded-xl">
            <source src="{{ video.url }}" />
            <p>Seu navegador não suporta reprodução de vídeo.</p>
          </video>
        </div>
      @end
    </div>

    <div class="flex gap-3">
      <a href="{{ route('videos.index') }}" class="btn-purple">← Voltar para Explorar</a>

      <a href="{{ route('home') }}" class="btn-purple">Ver no Para Você</a>

      <form
        action="{{ route('videos.destroy', { id: video.id }) }}?_method=DELETE"
        method="POST"
        onsubmit="return confirm('Tem certeza que deseja apagar este vídeo?');"
      >
        {{ csrfField() }}
        <button type="submit" class="btn-purple bg-red-600 hover:bg-red-700 cursor-pointer">
          Excluir Vídeo
        </button>
      </form>
    </div>
  </div>
@end
