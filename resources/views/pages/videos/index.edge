@layouts.app({ title: 'Explorar' })
  <div class="flex flex-col h-full w-full max-w-6xl mx-auto p-6 sm:p-8 gap-6 overflow-y-auto">
    <div class="flex justify-between items-center gap-4">
      <div>
        <h1 class="text-3xl font-extrabold">Explorar</h1>
        @if(search)
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Resultados da busca por: <strong>"{{ search }}"</strong>
          </p>
        @end
      </div>

      <div class="flex items-center gap-3">
        @if(search)
          <a href="{{ route('videos.index') }}" class="text-sm font-semibold text-purple-700 dark:text-purple-400 hover:underline">
            Limpar busca
          </a>
        @end
        <a href="{{ route('videos.create') }}" class="btn-purple">+ Enviar Vídeo</a>
      </div>
    </div>

    @if(videos.length > 0)
      <div class="columns-2 sm:columns-3 lg:columns-4 gap-4 space-y-4">
        @each(video in videos)
          @if(video.url)
            <a
              href="{{ route('home') }}?video={{ video.id }}"
              title="{{ video.title }}"
              class="block break-inside-avoid rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-transform duration-300 hover:scale-[1.02] cursor-pointer"
            >
              <video
                src="{{ video.url }}"
                muted
                loop
                playsinline
                preload="metadata"
                onmouseenter="this.play()"
                onmouseleave="this.pause(); this.currentTime = 0;"
                class="w-full h-auto block"
              ></video>
            </a>
          @end
        @end
      </div>
    @else
      <div class="text-lg flex flex-col items-center justify-center rounded-xl gap-4 p-12 my-auto text-zinc-500 dark:text-zinc-400">
        @if(search)
          <p>Nenhum vídeo encontrado para <strong>"{{ search }}"</strong>.</p>
          <a href="{{ route('videos.index') }}" class="btn-purple">Ver todos os vídeos</a>
        @else
          <p>Nenhum vídeo cadastrado no momento.</p>
          <a href="{{ route('videos.create') }}" class="btn-purple">Cadastrar o primeiro vídeo</a>
        @end
      </div>
    @end
  </div>
@end
